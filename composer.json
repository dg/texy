{
	"name": "texy/texy",
	"description": "📜 Texy: a text-to-HTML engine with its own easy-to-read markup, which you can change or extend, and real typography with proper quotes, dashes and non-breaking spaces. Always valid, sanitized HTML.",
	"keywords": ["texy", "markup", "markup language", "lightweight markup", "text to html", "typography", "wiki", "markdown"],
	"homepage": "https://texy.deegee.dev",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.2 - 8.6"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"tracy/tracy": "^2.9",
		"latte/latte": "^3.0.14",
		"phpstan/phpstan": "^2.3@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"conflict": {
		"latte/latte": ">=3.0.0 <3.0.14"
	},
	"replace": {
		"dg/texy": "*"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Texy\\": "src/Texy"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "4.0-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
